unit DataModuleMain;

interface

uses
  System.SysUtils, System.Classes, FireDAC.Stan.Intf, FireDAC.Stan.Option,
  FireDAC.Stan.Error, FireDAC.UI.Intf, FireDAC.Phys.Intf, FireDAC.Stan.Def,
  FireDAC.Stan.Pool, FireDAC.Stan.Async, FireDAC.Phys, FireDAC.VCLUI.Wait,
  FireDAC.Stan.ExprFuncs, FireDAC.Phys.SQLiteWrapper.Stat,
  FireDAC.Phys.SQLiteDef, FireDAC.Stan.Param, FireDAC.DatS, FireDAC.DApt.Intf,
  FireDAC.DApt, Data.DB, FireDAC.Comp.DataSet, FireDAC.Comp.Client,
  FireDAC.Phys.SQLite,
  //
  System.IOUtils, Vcl.Forms;

type
  TDMMain = class(TDataModule)
    FDConnection: TFDConnection;
    SQLiteDriver: TFDPhysSQLiteDriverLink;
    qry: TFDQuery;
    procedure DataModuleCreate(Sender: TObject);
    procedure DataModuleDestroy(Sender: TObject);
  private
    { Private declarations }
    procedure CreateDatabase;
    procedure CreateTables;
  public
    { Public declarations }
    procedure Connect;
    procedure Disconnect;
    procedure SaveMeasurement(ATemperature, APressure : Double; ALevel : Integer; AMotorOn : Boolean);
    procedure SaveEvent(const AEvent: string);
  end;

var
  DMMain: TDMMain;

implementation

{%CLASSGROUP 'Vcl.Controls.TControl'}

{$R *.dfm}

{ TDMMain }

procedure TDMMain.Connect;
var
  DBPath: string;
begin
  DBPath := TPath.Combine(ExtractFilePath(Application.ExeName), 'Data\SCADA.db');

  FDConnection.Close;
  FDConnection.Params.Clear;

  FDConnection.DriverName := 'SQLite';
  FDConnection.Params.Database := DBPath;
  FDConnection.LoginPrompt := False;

  if not DirectoryExists(ExtractFilePath(DBPath)) then
    begin
      ForceDirectories(ExtractFilePath(DBPath));
    end;
  //
  FDConnection.Connected := True;
  CreateTables;
end;

procedure TDMMain.CreateDatabase;
begin

end;

procedure TDMMain.CreateTables;
begin
  Qry.Connection := FDConnection;

  // Measurements
  Qry.SQL.Text := 'CREATE TABLE IF NOT EXISTS Measurements ('+
    'ID INTEGER PRIMARY KEY AUTOINCREMENT,'+
    'TimeStamp TEXT,'+
    'Temperature REAL,'+
    'Pressure REAL,'+
    'Level INTEGER,'+
    'MotorOn INTEGER);';

     Qry.ExecSQL;

  // Alarms
  Qry.SQL.Text := 'CREATE TABLE IF NOT EXISTS Alarms ('+
    'ID INTEGER PRIMARY KEY AUTOINCREMENT,'+
    'TimeStamp TEXT,'+
    'Level TEXT,'+
    'Message TEXT,'+
    'Status TEXT);';

    Qry.ExecSQL;

  // Events
  Qry.SQL.Text := 'CREATE TABLE IF NOT EXISTS Events ('+
    'ID INTEGER PRIMARY KEY AUTOINCREMENT,'+
    'TimeStamp TEXT,'+
    'Event TEXT);';

    Qry.ExecSQL;
end;

procedure TDMMain.DataModuleCreate(Sender: TObject);
begin
  Connect;
end;

procedure TDMMain.DataModuleDestroy(Sender: TObject);
begin
  Disconnect;
end;

procedure TDMMain.Disconnect;
begin
  if FDConnection.Connected then
    begin
      FDConnection.Close;
    end;
end;

procedure TDMMain.SaveEvent(const AEvent: string);
begin
  Qry.Close;


end;

procedure TDMMain.SaveMeasurement(ATemperature, APressure: Double; ALevel: Integer; AMotorOn: Boolean);
begin
  Qry.Close;

  Qry.SQL.Text := 'INSERT INTO Measurements ' +
    '(TimeStamp, Temperature, Pressure, Level, MotorOn) ' +
    'VALUES (:TS, :Temp, :Press, :Level, :Motor)';

  Qry.ParamByName('TS').AsString := FormatDateTime('yyyy-mm-dd hh:nn:ss', Now);

  Qry.ParamByName('Temp').AsFloat := ATemperature;
  Qry.ParamByName('Press').AsFloat := APressure;
  Qry.ParamByName('Level').AsInteger := ALevel;
  Qry.ParamByName('Motor').AsInteger := AMotorOn.ToInteger;
end;

end.
